{
  "name": "@reward-layer-protocol/rlp",
  "version": "0.1.3",
  "description": "TypeScript type definitions for the Reward Layer Protocol",
  "license": "Apache-2.0",
  "author": "Reward Layer Protocol contributors",
  "homepage": "https://github.com/Reward-Layer-Protocol/rlp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reward-Layer-Protocol/rlp.git"
  },
  "bugs": "https://github.com/Reward-Layer-Protocol/rlp/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-schemas.js",
    "lint": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.17.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
