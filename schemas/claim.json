{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-layer-protocol.github.io/rlp/schemas/claim.json",
  "$comment": "NON-NORMATIVE: Derived from spec/rlp.ts. See SPECIFICATION.md Section 4 for authoritative definitions.",
  "title": "RLP Claim",
  "description": "Request and response schemas for task claims",
  "$defs": {
    "ClaimRequest": {
      "type": "object",
      "required": ["output", "agentId"],
      "description": "Request body for submitting a claim",
      "properties": {
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "The agent's completed work"
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "description": "Agent authentication credential"
        }
      }
    },
    "ClaimResponse": {
      "type": "object",
      "required": ["status"],
      "description": "Response from a claim submission",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failed", "pending", "error"],
          "description": "Result of the claim: success, failed, pending, or error"
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation"
        },
        "reward": {
          "type": "object",
          "description": "Reward granted (present on success)",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "claimId": {
          "type": "string",
          "description": "Unique identifier for this claim (present when status is pending)"
        }
      }
    },
    "RlpError": {
      "type": "object",
      "required": ["code", "message"],
      "description": "Structured error response",
      "properties": {
        "code": {
          "type": "integer",
          "description": "RLP-specific error code (see Section 9 of SPECIFICATION.md)"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional additional details about the error"
        }
      }
    }
  }
}
